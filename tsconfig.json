{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "jsx": "preserve",
    "types": ["vitest/globals"],
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "#imports": ["./test/mocks/nuxt-imports.ts"]
    }
  },
  "include": ["src", "test", "vitest.config.ts"]
}
